APP_NAME="RapidJobs"
APP_ENV=local
APP_DEBUG=true
APP_URL="http://localhost/rapidjobs"

DB_HOST=localhost
DB_NAME=rapidjobs_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Token publico do Mapbox (opcional - para geocoding/busca por endereco)
MAPBOX_TOKEN=

# Limite de upload em bytes (padrao: 5 MB)
MAX_FILE_SIZE=5242880

# Sessao
SESSION_NAME=rapidjobs_session
SESSION_LIFETIME=86400
